# --- Required (app fails fast if missing) ---
S3_BUCKET=artsy-atelier
CLOUDFRONT_DISTRIBUTION_ID=E123EXAMPLE

# --- Optional (defaults shown) ---
S3_REGION=us-east-1
PUBLIC_DOMAIN=artsy.dev
MAX_UPLOAD_BYTES=52428800
PORT=8080

# --- Optional: site thumbnails (set all four or none) ---
# CF_API_TOKEN needs the "Browser Rendering - Edit" permission. The Access
# pair is the "Atelier programmatic access" service token.
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
